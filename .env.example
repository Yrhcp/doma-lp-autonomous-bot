# Copy to .env, fill in your own values locally, and never commit it.
RPC_URL=https://rpc.doma.xyz
EXPECTED_CHAIN_ID=97477
WALLET_ADDRESS=
POSITION_TOKEN_ID=
# Autonomous mode requires an independently funded dedicated wallet and its
# initial NFT; wallet address must also match the local key file.
AUTONOMOUS_WALLET_ADDRESS=
AUTONOMOUS_INITIAL_NFT=
# Comma-separated NFT IDs that must never be touched by automation.
PROTECTED_NFT_IDS=
# Optional, for the legacy manual rebalance UI only.
MANUAL_INITIAL_NFT=
MANUAL_INITIAL_MINT_TX=
EXIT_BUFFER_PERCENT=0.1
POLL_SECONDS=15
CONFIRM_SECONDS=60
RPC_TIMEOUT_SECONDS=10
SNAPSHOT_TIMEOUT_SECONDS=90
MAX_BLOCK_AGE_SECONDS=120
MAX_OBSERVATION_GAP_SECONDS=90
LOG_PATH=logs/monitor.jsonl
